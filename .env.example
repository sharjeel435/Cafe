# Copy to .env for local development. In Vercel, set these in Project Settings > Environment Variables.
# Use the PostgreSQL TCP connection string supplied by Prisma Postgres (postgres:// or postgresql://).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Generate a long random value; use the same value across the deployment's instances.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
# Optional: require this email domain for new student registrations.
UNIVERSITY_EMAIL_DOMAIN=""
